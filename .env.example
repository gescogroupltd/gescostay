# ─── Gescostay — Variables d'environnement requises ──────────────────────────
# Copiez ce fichier vers .env.local et remplissez les valeurs.
# Ce fichier peut être commité — il ne contient aucune valeur sensible.
#
#   cp .env.example .env.local
#
# Récupérez les valeurs dans votre tableau de bord Supabase :
#   https://supabase.com/dashboard/project/<project-ref>/settings/api

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
